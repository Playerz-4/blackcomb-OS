// Live media has no root password, so the normal polkit prompt for changing
// the system keyboard/locale layout can never be answered. Allow every
// systemd-localed action unconditionally: the D-Bus caller is not always the
// visible desktop user (KDE/KISS setup helpers can run under a different
// account), so matching a username or a single action name can still leave
// the prompt in place.
//
// The 00- prefix makes this authoritative: polkit reads rules in lexical
// order and stops at the first rule that returns a result, before Fedora's
// later rules can ask for authentication. A matching legacy .pkla is also
// installed as a fallback. These files go into the disposable live root only,
// not an installed system.
polkit.addRule(function(action, subject) {
    if (action.id.indexOf("org.freedesktop.locale1.") === 0) {
        return polkit.Result.YES;
    }
});

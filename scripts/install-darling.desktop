[Desktop Entry]
Type=Application
Name=Install macOS App Support
GenericName=Darling Installer
Comment=Build and install experimental native macOS app support
Exec=pkexec /usr/local/bin/blackcomb-install-darling --yes
Icon=/usr/share/blackcomb/branding/crescent-moon-start-icon.png
Terminal=true
Categories=Settings;System;
StartupNotify=true

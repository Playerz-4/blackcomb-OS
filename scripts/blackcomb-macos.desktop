[Desktop Entry]
Type=Application
Name=Blackcomb macOS Apps
GenericName=macOS Compatibility
Comment=Run native macOS apps and disk images with Darling
Exec=blackcomb-macos %f
Icon=/usr/share/blackcomb/branding/crescent-moon-start-icon.png
Terminal=true
Categories=System;Utility;
MimeType=application/x-apple-diskimage;application/x-dmg;application/vnd.apple.dmg;application/x-macapplication;application/x-apple-app;application/x-apple-macos-pkg;
StartupNotify=true
